    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "@eslint/js": "^9.17.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
